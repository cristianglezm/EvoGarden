{
  "name": "evogarden",
  "version": "2.34.4",
  "description": "A dynamic garden simulation where flowers evolve under the pressure of insects and birds. Watch a Darwinian battlefield unfold as flowers, insects, and birds interact in a delicate ecosystem, with visual traits driven by NEAT Algorithm.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/checkBuild.mjs",
    "buildGH": "tsc && vite build --base=/EvoGarden/",
    "postbuildGH": "node scripts/checkBuild.mjs",
    "preview": "vite preview",
    "show": "npx playwright show-report",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --update-snapshots",
    "lint": "oxlint",
    "format": "oxfmt src e2e scripts vite.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src e2e scripts vite.config.ts playwright.config.ts"
  },
  "author": "Cristian Gonzalez <cristian.glez.m@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@cristianglezm/flower-evolver-wasm": "^4.1.0",
    "@cristianglezm/live-commentary-widget": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dexie": "^4.4.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "vite-plugin-pwa": "^2.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react-devtools": "^8.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
