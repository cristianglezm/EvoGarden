{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "ignorePatterns": ["dist", "node_modules", "playwright-report", "test-results", "e2e/**/*-snapshots", "package-lock.json"]
}
